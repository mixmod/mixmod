#MkInclude = $(R_HOME)/etc${R_ARCH}/Makeconf

CXX_STD = CXX17

##
## MIXMOD AND EIGEN
##
MIXMODDIR    = ./mixmod
IOSTREAMDIR  = ./mixmod_iostream
MIXMODLIB    = mixmod.a


PKG_CXXFLAGS = -DWITHOUT_OMP -DXEM_RESOURCES_PATH='"$(R_PACKAGE_DIR)/XML_specs"' $(RMIXMOD_XML) -I. -I./mixmod_iostream $(LIBXMLXX_CFLAGS)
## Use the R_HOME indirection to support installations of multiple R version
PKG_LIBS = -L$(MIXMODDIR) $(MIXMODLIB) $(LIBXMLXX_LIBS)

##
## Targets
##
.PHONY: all mixmod

all: $(SHLIB)

$(SHLIB): mixmod

mixmod:
	(cd $(MIXMODDIR) && $(MAKE) -f mixmod_r.mk)
	(if test ! -z $(RMIXMOD_XML) ; then cd $(IOSTREAMDIR) && $(MAKE) -f mixmod_iostream_r.mk ; fi)
	$(RANLIB) $(MIXMODLIB)
